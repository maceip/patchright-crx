{
  "name": "Patchright CRX API",
  "description": "High-performance browser automation API for external applications",
  "version": "0.15.0",
  "manifest_version": 3,
  "key": "",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["debugger", "tabs", "nativeMessaging"],
  "externally_connectable": {
    "matches": ["<all_urls>"],
    "ids": ["*"]
  },
  "web_accessible_resources": [
    {
      "resources": ["api.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
      "16": "logo-16.png",
      "32": "logo-32.png",
      "34": "logo-34.png",
      "48": "logo-48.png",
      "128": "logo-128.png"
    }
}
